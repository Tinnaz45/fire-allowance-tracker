# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is listed in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional — only needed if email features are enabled
RESEND_API_KEY=your-resend-key-here
EMAIL_FROM=onboarding@resend.dev

# ── Feature flags ─────────────────────────────────────────────────────────────
# Payments / Reconciliation feature (the /payments + /payments/imports routes and
# the Payments nav tab). Leave UNSET to use environment defaults: ON for the local
# dev server and the DEV Supabase deployment, OFF for PROD. Set explicitly to
# override: true|1|on to force on, false|0|off to force off. See
# docs/PAYMENTS_FEATURE_FLAG.md.
# NEXT_PUBLIC_PAYMENTS_ENABLED=

# ── Payslip OCR (optional) ────────────────────────────────────────────────────
# Automatic payslip-screenshot OCR extraction is DISABLED unless a real provider key
# is configured. With no key, /api/payslip/extract returns 503 and the "Extract
# lines" UI is hidden — manual entry, reconciliation, and screenshot storage all keep
# working. The deterministic STUB (which fabricates sample lines) is NEVER used as a
# user-facing fallback and is never honored in production. A PII/privacy review is
# required before sending real payslip images to a third-party vision model.
#   OPENAI_API_KEY=your-openai-key-here        # enables OpenAI Vision OCR
#   PAYSLIP_OCR_PROVIDER=openai                # 'openai' (default) | 'anthropic'
#   PAYSLIP_OCR_MODEL=gpt-4o-mini              # optional provider-specific model
#   ANTHROPIC_API_KEY=your-anthropic-key-here  # only if PAYSLIP_OCR_PROVIDER=anthropic
# Local/dev ONLY — allow the deterministic stub extractor for framework testing.
# Ignored in production. Leave UNSET normally.
#   PAYSLIP_OCR_ALLOW_STUB=
