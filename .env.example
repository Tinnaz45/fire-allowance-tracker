# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is listed in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional — only needed if email features are enabled
RESEND_API_KEY=your-resend-key-here
EMAIL_FROM=onboarding@resend.dev

# ── Feature flags ─────────────────────────────────────────────────────────────
# Payments / Reconciliation feature (the /payments + /payments/imports routes and
# the Payments nav tab). Leave UNSET to use environment defaults: ON for the local
# dev server and the DEV Supabase deployment, OFF for PROD. Set explicitly to
# override: true|1|on to force on, false|0|off to force off. See
# docs/PAYMENTS_FEATURE_FLAG.md.
# NEXT_PUBLIC_PAYMENTS_ENABLED=

# Optional — only needed when enabling real payslip OCR (otherwise the deterministic
# stub runs). Forcing the stub: PAYSLIP_OCR_PROVIDER=stub. A PII/privacy review is
# required before sending real payslip images to a third-party vision model.
# OPENAI_API_KEY=your-openai-key-here
# PAYSLIP_OCR_PROVIDER=stub
